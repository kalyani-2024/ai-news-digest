# Google Gemini
GEMINI_API_KEY=

# Model overrides (optional - defaults shown)
DIGEST_MODEL=gemini-3.5-flash-lite
CURATOR_MODEL=gemini-3.5-flash
EMAIL_MODEL=gemini-3.5-flash

# Email delivery (Gmail app password, not your account password)
MY_EMAIL=
APP_PASSWORD=
DIGEST_RECIPIENTS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Database - full connection string (Supabase session pooler, Neon, etc.)
DATABASE_URL=
# Or the individual parts, for local Docker Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_news_aggregator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Curation profile - shapes how articles are ranked
USER_NAME=
USER_TITLE=
USER_BACKGROUND=
USER_EXPERTISE_LEVEL=Advanced

# Comma-separated YouTube channel IDs (UC...) to follow
YOUTUBE_CHANNELS=

# Pipeline tuning (optional - defaults shown)
DIGEST_CONCURRENCY=4
MAX_RANK_ATTEMPTS=2
GEMINI_MAX_ATTEMPTS=4
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# LangSmith tracing (optional) - every LangChain/LangGraph call is traced, no code changes
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-news-aggregator
